# Copy to .env.local for local overrides. Never commit real secrets.

# Server-side data mode: demo | production (see docs/07-technical-architecture.md §8)
# demo   — development/demo environments only; synthetic data must stay labelled
# production — never serve synthetic academic records
APP_DATA_MODE=demo

# Supabase (P2.0 foundation — local CLI values after `npx supabase start`)
# These are publishable/local identifiers, not service-role secrets.
# Never place the service-role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
